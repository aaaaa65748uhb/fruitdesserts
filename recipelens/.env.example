# ---------------------------------------------------------------------------
# RecipeLens — environment configuration
# Copy this file to `.env` (never commit `.env`) and fill in the values.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Port the API server listens on.
PORT=4000
# "development" | "test" | "production"
NODE_ENV=development
# Origin of the web client, used for CORS + cookie settings.
WEB_ORIGIN=http://localhost:5173

# --- Security ---------------------------------------------------------------
# Secret used to sign session tokens. MUST be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Session lifetime in seconds (default 604800 = 7 days).
SESSION_TTL_SECONDS=604800

# --- Database ---------------------------------------------------------------
# SQLite file path (relative paths resolve from the server workspace root),
# or ":memory:" for an ephemeral database.
DATABASE_URL=file:./data/recipelens.db

# --- AI provider ------------------------------------------------------------
# Which provider implementation to use.
# Supported: openai | openai-compatible | anthropic | gemini
AI_PROVIDER=openai-compatible
# API key for the provider. Server-side ONLY — never expose to the browser.
AI_API_KEY=
# Base URL of an OpenAI-compatible chat-completions API,
# e.g. https://api.openai.com/v1 or https://api.groq.com/openai/v1
AI_API_BASE_URL=https://api.openai.com/v1
# Model identifier, e.g. gpt-4o-mini / llama-3.3-70b-versatile
AI_MODEL=gpt-4o-mini
# Request timeout in milliseconds for a single AI call.
AI_TIMEOUT_MS=45000
# How many times a malformed/invalid AI response is retried before failing.
AI_MAX_RETRIES=2

# --- Google sign-in (optional) ----------------------------------------------
# OAuth client ID used to verify Google ID tokens. Leave empty to disable
# Google sign-in: the API then answers 503 GOOGLE_NOT_CONFIGURED and the UI
# does not show the button. This is a public identifier, not a secret.
GOOGLE_CLIENT_ID=
# Override Google's JWKS endpoint. Only used by automated tests.
GOOGLE_JWKS_URL=

# --- Android build ----------------------------------------------------------
# Read at BUILD time by the web client (Vite) and baked into the APK: the
# address of the RecipeLens backend the app should call, e.g.
# https://api.recipelens.example. Not a secret — the APK never holds an AI key.
VITE_API_BASE_URL=

# --- Not used by this build -------------------------------------------------
# RecipeLens currently stores data in SQLite through DATABASE_URL above.
# These are listed for a future Postgres/Supabase adapter and are ignored today.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Uploads ----------------------------------------------------------------
# Maximum accepted upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760
