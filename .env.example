# הגדרות Firebase — העתיקו לקובץ .env.local ומלאו את הערכים מ-Firebase Console
# (הגדרות הפרויקט ← האפליקציות שלך ← Firebase SDK snippet ← Config)
# ללא ערכים אלה האתר רץ במצב דמו עם נתונים מקומיים בדפדפן.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# האימייל של חשבון Google היחיד שמורשה להיכנס לדשבורד הניהול.
# חשוב: יש לעדכן את אותו אימייל גם ב-firestore.rules וב-storage.rules!
NEXT_PUBLIC_ADMIN_EMAIL=aecake273@gmail.com

# נתיב בסיס לפריסה תחת תת-נתיב (למשל GitHub Pages): /repo-name
NEXT_PUBLIC_BASE_PATH=
