# Optional. When set, the catalog is served from PostgreSQL (run `npx prisma db push && npx prisma db seed`).
# When unset, SUPERIL uses the bundled development dataset + any files imported with `npm run import:feed`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/superil"

# Branding (configurable)
NEXT_PUBLIC_BRAND_NAME="SUPERIL"

# CHP adapter: stays disabled until written authorization from CHP exists. Do NOT enable without it.
CHP_AUTHORIZED="false"
CHP_API_BASE_URL=""
CHP_API_KEY=""
