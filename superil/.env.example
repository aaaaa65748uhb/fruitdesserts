# ── Storage ───────────────────────────────────────────────────────────────────
# PostgreSQL connection. REQUIRED for a public server (imports are refused in production without it).
# Leave empty on your own computer to store data as files in data/imported.
# Example: postgresql://USER:PASSWORD@HOST:5432/superil   → then run: npm run db:migrate
DATABASE_URL=""
# JSON price store location when DATABASE_URL is not set (default: data/imported)
PRICE_DATA_DIR=""
# Reviewed links between catalog products and barcodes (default: data/barcode-map.json)
BARCODE_MAP_FILE=""

# ── Price freshness ──────────────────────────────────────────────────────────
# Prices from a file published within this many hours are labelled "מחיר מאומת" (verified)
PRICE_VERIFIED_MAX_AGE_HOURS=36
# After this many days prices are "מחיר לא עדכני" (stale) and excluded from basket totals
PRICE_STALE_AFTER_DAYS=7
# auto (default): sample prices only until the first official file is imported; on / off to force
SAMPLE_PRICES=auto

# ── Admin import interface (/admin/prices) ───────────────────────────────────
# Disabled unless set. Use a long random value (at least 24 characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=""
ADMIN_MAX_UPLOAD_MB=100

# ── Docker Compose only (docker-compose.yml) ─────────────────────────────────
POSTGRES_PASSWORD=""
# Optional mirrors if Docker Hub rate-limits you:
# NODE_IMAGE=mirror.gcr.io/library/node:22-bookworm
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16

# ── Branding ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME="SUPERIL"

# ── CHP adapter: stays disabled until written authorization from CHP exists ──
CHP_AUTHORIZED="false"
CHP_API_BASE_URL=""
CHP_API_KEY=""
