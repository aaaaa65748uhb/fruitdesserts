# ── Storage ───────────────────────────────────────────────────────────────────
# Optional. When set, the catalog AND imported official prices are stored in PostgreSQL
# (run `npm run db:push && npm run db:seed`). When unset, prices are stored as JSON files.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/superil"
# JSON price store location when DATABASE_URL is not set (default: data/imported)
PRICE_DATA_DIR=""
# Reviewed links between catalog products and barcodes (default: data/barcode-map.json)
BARCODE_MAP_FILE=""

# ── Price freshness ──────────────────────────────────────────────────────────
# Prices from a file published within this many hours are labelled "מחיר מאומת" (verified)
PRICE_VERIFIED_MAX_AGE_HOURS=36
# After this many days prices are "מחיר לא עדכני" (stale) and excluded from basket totals
PRICE_STALE_AFTER_DAYS=7
# auto (default): sample prices only until the first official file is imported; on / off to force
SAMPLE_PRICES=auto

# ── Admin import interface (/admin/prices) ───────────────────────────────────
# Disabled unless set. Use a long random value (at least 24 characters), e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=""
ADMIN_MAX_UPLOAD_MB=100

# ── Branding ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME="SUPERIL"

# ── CHP adapter: stays disabled until written authorization from CHP exists ──
CHP_AUTHORIZED="false"
CHP_API_BASE_URL=""
CHP_API_KEY=""
