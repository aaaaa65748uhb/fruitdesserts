// SUPERIL persistent data model. Product identity is separate from retailer offers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String       @id
  nameHe             String
  nameEn             String?
  brand              String
  category           String
  barcode            String?      @unique
  packageSize        Float
  packageUnit        String
  multipack          Int?
  imageUrl           String?
  imageSource        String?
  imageLicense       String?
  manufacturer       String?
  dietaryTags        String[]
  productDescription String?
  provenance         String
  packagingShape     String       @default("box")
  packagingColor     String       @default("#e2e8f0")
  packagingAccent    String       @default("#334155")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  offers             PriceOffer[]

  @@index([category])
  @@index([brand])
}

model Retailer {
  id              String       @id
  nameHe          String
  nameEn          String
  homepageUrl     String
  homepageVerified Boolean     @default(false)
  integration     String
  deliveryFee     Float?
  minimumOrder    Float?
  branches        Branch[]
  offers          PriceOffer[]
}

model Branch {
  id          String       @id
  retailerId  String
  retailer    Retailer     @relation(fields: [retailerId], references: [id])
  name        String
  city        String
  address     String?
  zipCode     String?
  source      String
  /** Fields below come only from official Stores files. */
  storeId     String?
  subChainId  String?
  chainId     String?
  cityIsCode  Boolean      @default(false)
  publishedAt DateTime?
  importId    String?
  offers      PriceOffer[]

  @@index([retailerId, city])
}

/** One imported official file (or archive entry). fileHash+entryName makes repeated imports detectable. */
model ImportBatch {
  id                String   @id
  fileHash          String
  uploadName        String
  entryName         String
  kind              String
  retailerId        String
  chainId           String?
  subChainId        String?
  storeId           String?
  publishedAt       DateTime
  publishedAtSource String
  importedAt        DateTime
  importedBy        String
  provenance        String
  counts            Json
  applied           Json
  issues            Json

  @@index([fileHash, entryName])
}

/** Current official price per branch and product key ("g:<gtin>" or "i:<retailer>:<code>"). */
model OfficialPrice {
  retailerId         String
  storeId            String
  productKey         String
  itemCode           String
  barcode            String?
  name               String
  manufacturer       String?
  quantity           Float
  unit               String
  isWeighted         Boolean
  price              Float
  unitOfMeasurePrice Float?
  priceChangedAt     DateTime?
  publishedAt        DateTime
  importId           String
  sourceFile         String
  importedAt         DateTime

  @@id([retailerId, storeId, productKey])
  @@index([productKey])
}

model BranchPriceState {
  retailerId          String
  storeId             String
  chainId             String?
  subChainId          String?
  lastFullPublishedAt DateTime?
  lastPromoFullAt     DateTime?

  @@id([retailerId, storeId])
}

model OfficialPromotion {
  retailerId  String
  storeId     String
  promotionId String
  productKeys String[]
  publishedAt DateTime
  data        Json

  @@id([retailerId, storeId, promotionId])
  @@index([productKeys], type: Gin)
}

model FeedProduct {
  productKey         String   @id
  barcode            String?
  internalRetailerId String?
  itemCode           String
  name               String
  manufacturer       String?
  quantity           Float
  unit               String
  isWeighted         Boolean
  firstSeenImportId  String
  firstSeenAt        DateTime
}

model ChainMapping {
  chainId    String @id
  retailerId String
}

model PriceOffer {
  id               String    @id
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailerId       String
  retailer         Retailer  @relation(fields: [retailerId], references: [id])
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id])
  price            Float
  unitPrice        Float?
  unitPriceBasis   String?
  currency         String    @default("ILS")
  promotionJson    Json?
  availability     String    @default("unknown")
  sourceProvider   String
  sourceUrl        String?
  lastVerifiedAt   DateTime?
  freshness        String
  matchConfidence  Float     @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([productId])
  @@index([retailerId, branchId])
}

/** Guest carts can be persisted server-side when a user opts in to an account later. */
model Cart {
  id        String     @id @default(cuid())
  userId    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lines     CartLine[]
}

model CartLine {
  id                 String  @id @default(cuid())
  cartId             String
  cart               Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId          String
  quantity           Int
  selectedRetailerId String?

  @@unique([cartId, productId])
}

/** Reviewed decision linking (approved) or refusing to link (rejected) a catalog product and an identifier. */
model MappingDecision {
  productId String
  key       String
  status    String
  decidedAt DateTime
  decidedBy String
  note      String?

  @@id([productId, key])
  @@index([key])
}

/** Original uploaded official files (gzip-compressed), kept for audit and re-processing. */
model ImportFile {
  fileHash   String   @id
  uploadName String
  sizeBytes  Int
  uploadedAt DateTime
  uploadedBy String
  data       Bytes
}
